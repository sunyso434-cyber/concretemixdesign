{
  "name": "concrete-mixdesign",
  "version": "0.9.3",
  "description": "砼智 Concrete Agent",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "set \"ELECTRON_RUN_AS_NODE=\" && cross-env NODE_ENV=development electron .",
    "electron:build": "cross-env NODE_ENV=production vite build && electron-builder",
    "test": "jest",
    "test:manual": "node tests/manual/run-node-suites.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint --no-warn-ignored \"src/**/*.js\" \"src/**/*.jsx\" main.js tests migrations *.config.js",
    "lint:fix": "eslint --no-warn-ignored --fix \"src/**/*.js\" \"src/**/*.jsx\" main.js tests migrations *.config.js"
  },
  "keywords": [
    "concrete",
    "mix design",
    "electron",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "overrides": {
    "msgpackr-extract": false
  },
  "dependencies": {
    "@ant-design/plots": "^2.6.8",
    "@effect/experimental": "^0.60.0",
    "@effect/platform": "^0.96.3",
    "@effect/sql": "^0.51.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@reduxjs/toolkit": "^2.0.0",
    "@wlearn/xgboost": "^0.2.0",
    "antd": "^5.12.0",
    "async-mutex": "^0.5.0",
    "axios": "^1.15.2",
    "chokidar": "^3.6.0",
    "docx": "^9.7.1",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.6",
    "effect": "^3.22.0",
    "effect-search": "^0.2.1",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.7.2",
    "js-yaml": "^4.2.0",
    "mammoth": "^1.12.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.0.0",
    "react-router-dom": "^6.22.0",
    "remark-gfm": "^4.0.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "vega": "^6.3.1",
    "vega-lite": "^6.4.3",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5",
    "yauzl": "^3.4.0"
  },
  "type": "commonjs",
  "build": {
    "appId": "com.concrete.mixdesign",
    "productName": "砼智",
    "copyright": "Copyright © 2026",
    "publish": null,
    "directories": {
      "output": "dist-0.9.3",
      "buildResources": "public"
    },
    "files": [
      "main.js",
      "package.json",
      "build/**",
      "src/main/**",
      "src/main/remote/**",
      "migrations/*.js",
      "src/shared/**",
      "resources/models/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "resources/officecli/${os}/",
        "to": "officecli/",
        "filter": [
          "**/*",
          "!*.update.partial",
          "!*.old",
          "!*.bak.*"
        ]
      },
      {
        "from": "resources/frpc",
        "to": "frpc/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/sqlite3/**",
      "resources/models/**",
      "node_modules/@wlearn/xgboost/**"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": [
        "sha256"
      ],
      "sign": null
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-x64.exe"
    },
    "buildDependenciesFromSource": true,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "砼智"
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^29.1.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.0",
    "vite": "^5.4.21"
  }
}
