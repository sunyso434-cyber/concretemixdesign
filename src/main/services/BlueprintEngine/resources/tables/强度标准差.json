    "function": "getStrengthStdDev",
    "lines": "5-40"
  },
  "standard": "JGJ 55-2011 表4.2.1 混凝土强度标准差",
  "unit": "MPa",
  "interpolation": "step",
  "dimensions": [
    { "name": "强度等级", "unit": null, "values": ["C15-C20", "C25-C45", "C50-C60"] }
