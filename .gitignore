# 测试 fixture（自动生成，不入仓）
src/main/__tests__/workspace/readers/fixtures/*.pdf
src/main/__tests__/workspace/readers/fixtures/*.docx
src/main/__tests__/workspace/readers/fixtures/*.xlsx
