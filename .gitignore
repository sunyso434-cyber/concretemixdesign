# OfficeCLI 二进制（通过 download:officecli 下载，打包时 electron-builder 自动包含）
resources/officecli/*/officecli
resources/officecli/*/officecli.exe
# OfficeCLI 自动更新产生的残留文件（旧版备份 + 下载分片），不入仓
resources/officecli/*/*.old
resources/officecli/*/*.update.partial
resources/officecli/*/*.bak.*
# OfficeCLI 自动更新下载的临时分片文件
*.update.partial

# frp 二进制（frpc.exe 通过 R12 手动放置，打包时 electron-builder 自动包含，不入仓）
resources/frpc/*/frpc.exe

# 一次性恢复/抢救脚本（一次性使用，跑完可删）
scripts/recover-*.js

# === 项目整理（2026-07-23）：项目无关杂项不入仓 ===

# 归档目录（项目无关文件归档，仅本地保留）
_archive/

# 构建产物（vite build 输出，打包时自动生成）
build/

# 运行时数据库（程序运行时读写，不入仓）
data/
db/

